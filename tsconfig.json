{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "outDir": "./public",
    "rootDir": "./src/ts",
    "baseUrl": ".",
    "paths": {
      "@solana/spl-token": ["node_modules/@solana/spl-token"]
    }
  },
  "include": ["src/ts/**/*.ts"],
} 